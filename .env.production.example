# Zokyo - producao
# Nunca use estes placeholders diretamente.
FLASK_ENV=production
SECRET_KEY=SUBSTITUA_POR_64_HEX_ALEATORIOS
DATABASE_URL=mysql+pymysql://zokyo:${MYSQL_PASSWORD}@db:3306/zokyo?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=900
DB_ISOLATION_LEVEL=READ COMMITTED
ENCRYPTION_SALT=SUBSTITUA_POR_BASE64_DE_32_BYTES
BLIND_INDEX_KEY=SUBSTITUA_POR_BASE64_URLSAFE_DE_32_BYTES
PUBLIC_BASE_URL=https://zokyo.seudominio.com

# Cookies/proxy
PROXY_COUNT=1

# Laudos e storage privado
REPORTS_UPLOAD_FOLDER=/var/lib/zokyo/uploads/reports
REPORTS_PUBLIC_VERIFICATION=true
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256
SCHEDULER_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_TOKEN=SUBSTITUA_POR_TOKEN_ALEATORIO_LONGO
BACKUP_ENCRYPTION_KEY=SUBSTITUA_POR_BASE64_URLSAFE_DE_32_BYTES
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_ALLOWED_HOSTS=
REQUIRE_ADMIN_2FA=true

# Rate limit global
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_GET=1000
RATE_LIMIT_GLOBAL_WRITE=300
RATE_LIMIT_GLOBAL_API=600
RATE_LIMIT_ENDPOINT_GET=300
RATE_LIMIT_ENDPOINT_WRITE=120
RATE_LIMIT_ENDPOINT_API=240
REDIS_URL=redis://redis:6379/0

# Asaas opcional
# Configure ASAAS_API_KEY e coloque ASAAS_SANDBOX=false para produção.
ASAAS_API_KEY=
ASAAS_SANDBOX=false
ASAAS_BASE_URL=
ASAAS_TIMEOUT=15
ASAAS_USER_AGENT=Zokyo/1.0 (Flask)
ASAAS_WEBHOOK_TOKEN=SUBSTITUA_POR_TOKEN_DE_WEBHOOK_COM_32_OU_MAIS_CARACTERES

# WhatsApp opcional
# Integracao oficial Meta Cloud API (prioritaria). A versao deve ser definida
# conforme a versao ativa no painel Meta, por exemplo vXX.X.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=

# Administracao SaaS e webhook sandbox
PLATFORM_ADMIN_EMAILS=admin@seudominio.com
BILLING_SANDBOX_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO
HTTP_PORT=80

# Gunicorn e logs
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_ACCESSLOG=-
GUNICORN_ERRORLOG=-
GUNICORN_FORWARDED_IPS=127.0.0.1
LOG_DIR=/var/log/zokyo

# Firebird legado opcional
FIREBIRD_CLIENT_LIBRARY=
