# Zokyo - producao
# Nunca use estes placeholders diretamente.
FLASK_ENV=production
SECRET_KEY=SUBSTITUA_POR_64_HEX_ALEATORIOS
DATABASE_URL=mysql+pymysql://zokyo:SUBSTITUA@db:3306/zokyo
ENCRYPTION_SALT=SUBSTITUA_POR_BASE64_DE_32_BYTES

# Cookies/proxy
PROXY_COUNT=1

# PDF
WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf

# Laudos e storage privado
REPORTS_UPLOAD_FOLDER=/var/lib/zokyo/uploads/reports
REPORTS_PUBLIC_VERIFICATION=true

# WhatsApp opcional
WPP_SERVER_URL=
WPP_SECRET=

# Observabilidade opcional
SENTRY_DSN=
LOG_LEVEL=INFO

# Backup/storage externo opcional
BACKUP_OUTPUT_DIR=/var/backups/zokyo
