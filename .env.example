# Zokyo - desenvolvimento local
FLASK_ENV=development
SECRET_KEY=gere_um_valor_seguro_com_python_secrets
DATABASE_URL=mysql+pymysql://zokyo:troque-esta-senha@localhost:3306/zokyo
ENCRYPTION_SALT=

# Laudos
REPORTS_UPLOAD_FOLDER=
REPORTS_PUBLIC_VERIFICATION=true
SCHEDULER_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_TOKEN=
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_ALLOWED_HOSTS=
REQUIRE_ADMIN_2FA=false

# WhatsApp opcional
WPP_SERVER_URL=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=
WPP_SECRET=
WPP_ALLOWED_HOSTS=

# Administracao SaaS e billing sandbox
PLATFORM_ADMIN_EMAILS=
BILLING_SANDBOX_SECRET=
HTTP_PORT=8000

# Firebird/CPlus opcional
FIREBIRD_CLIENT_LIBRARY=

# Proxy/deploy local
PROXY_COUNT=1

# Gunicorn (opcional fora do Docker)
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_ACCESSLOG=-
GUNICORN_ERRORLOG=-
GUNICORN_FORWARDED_IPS=127.0.0.1
LOG_DIR=logs
