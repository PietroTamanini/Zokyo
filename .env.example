# Zokyo - desenvolvimento local
FLASK_ENV=development
SECRET_KEY=gere_um_valor_seguro_com_python_secrets
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/zokyo?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=900
DB_ISOLATION_LEVEL=READ COMMITTED
ENCRYPTION_SALT=
BLIND_INDEX_KEY=

# Laudos
REPORTS_UPLOAD_FOLDER=
REPORTS_PUBLIC_VERIFICATION=true
SCHEDULER_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_TOKEN=
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_ALLOWED_HOSTS=
REQUIRE_ADMIN_2FA=false

# Rate limit global
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_GET=1000
RATE_LIMIT_GLOBAL_WRITE=300
RATE_LIMIT_GLOBAL_API=600
RATE_LIMIT_ENDPOINT_GET=300
RATE_LIMIT_ENDPOINT_WRITE=120
RATE_LIMIT_ENDPOINT_API=240

# Asaas opcional
# Deixe vazio para usar o fallback local de cobrança/PIX.
ASAAS_API_KEY=
ASAAS_SANDBOX=true
ASAAS_BASE_URL=
ASAAS_TIMEOUT=15
ASAAS_USER_AGENT=Zokyo/1.0 (Flask)

# WhatsApp opcional
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=

# Administracao SaaS e billing sandbox
PLATFORM_ADMIN_EMAILS=
BILLING_SANDBOX_SECRET=
TENANT_BASE_DOMAIN=tamanini.dev.br
# manual: mostra instrucoes; wildcard: use um DNS *.dominio apontando para o servidor; cloudflare: cria/atualiza registro por empresa.
TENANT_DNS_MODE=manual
TENANT_DNS_TARGET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
HTTP_PORT=8000

# Firebird legado opcional
FIREBIRD_CLIENT_LIBRARY=

# Proxy/deploy local
PROXY_COUNT=1
DJTECH_SITE_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Gunicorn (opcional fora do Docker)
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_ACCESSLOG=-
GUNICORN_ERRORLOG=-
GUNICORN_FORWARDED_IPS=127.0.0.1
LOG_DIR=logs
