# Zokyo — Variáveis de Ambiente
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env real.

# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_VALOR_GERADO_ACIMA

# MySQL — usuário dedicado, NÃO root
# sudo mysql -e "CREATE DATABASE zokyo CHARACTER SET utf8mb4;"
# sudo mysql -e "CREATE USER 'zokyo'@'localhost' IDENTIFIED BY 'SenhaForte';"
# sudo mysql -e "GRANT ALL ON zokyo.* TO 'zokyo'@'localhost';"
DATABASE_URL=mysql+pymysql://zokyo:SUBSTITUA_SENHA@localhost:3306/zokyo

# Ambiente: development | production
FLASK_ENV=production

# PDF — Ubuntu: sudo apt install wkhtmltopdf
# WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf

# WhatsApp
# WPP_SERVER_URL=http://127.0.0.1:3333
# WPP_SECRET=SEGREDO_FORTE_AQUI

# Número de workers Gunicorn (ex: (2 * CPUs) + 1)
# GUNICORN_WORKERS=4

# Proxy reverso — quantos níveis de X-Forwarded-For confiar (padrão: 1)
# PROXY_COUNT=1
